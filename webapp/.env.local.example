# Copia este archivo a .env.local y completa con los valores de tu proyecto Firebase
# (Firebase Console > Configuracion del proyecto > Tus apps > Config SDK)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary: hospedaje de fotos de productos (plan gratis, sin tarjeta).
# Crea una cuenta en https://cloudinary.com, luego un "Upload preset" en modo
# "Unsigned" (Settings > Upload > Upload presets > Add upload preset).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Datos de la tienda (usados en toda la web)
NEXT_PUBLIC_STORE_NAME="Hamsa Shoes"
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=57
NEXT_PUBLIC_WHATSAPP_NUMBER=3508258757
# Valor por defecto del correo que recibe cada pedido nuevo — también se
# puede cambiar sin redesplegar desde /admin/configuracion.
NEXT_PUBLIC_NOTIFICATION_EMAIL=

# URL pública real de tu tienda (sin barra final). Se usa para el favicon,
# la vista previa al compartir el link (WhatsApp, Facebook, iMessage...) y
# las etiquetas Open Graph / Twitter Card.
NEXT_PUBLIC_SITE_URL=https://calzadohamsa.com

# Wompi (opcional): pago en línea inmediato con tarjeta/PSE/Nequi.
# Sin NEXT_PUBLIC_WOMPI_PUBLIC_KEY + WOMPI_INTEGRITY_SECRET, el botón de pago
# en línea no aparece y todo sigue funcionando solo con pago contra entrega.
# Consigue las 3 llaves en https://comercios.wompi.co > Desarrolladores >
# Llaves de la API — son TRES valores DISTINTOS, no dos:
#   1. Llave pública       (pub_prod_... / pub_test_...)      -> NEXT_PUBLIC_WOMPI_PUBLIC_KEY
#   2. Secreto de integridad (una cadena larga, NO empieza con "prv_") -> WOMPI_INTEGRITY_SECRET
#   3. Llave privada       (prv_prod_... / prv_test_...)      -> WOMPI_PRIVATE_KEY
# La llave privada (3) NO sirve como secreto de integridad (2) — son cosas
# diferentes en el panel de Wompi. Sin el secreto de integridad correcto,
# el pago en línea falla con "firma inválida" aunque las otras dos estén bien.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Opcional: solo se usa para verificar en el servidor que el pago quedó
# realmente aprobado antes de mostrarlo como confirmado al cliente.
WOMPI_PRIVATE_KEY=

# Resend (opcional): correo de notificación por cada pedido nuevo, igual que
# Shopify. Sin RESEND_API_KEY el checkout funciona igual, solo que no se
# envía el correo. Consíguela gratis en https://resend.com (API Keys).
# RESEND_FROM_EMAIL es opcional — requiere verificar tu dominio en Resend
# para poder recibir en cualquier correo (ver README.md).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Notificaciones push (opcional): avisa al celular de la administradora
# cuando llega un pedido nuevo, aunque la tienda no esté abierta — igual
# que la app de Shopify. Sin estas variables, el botón de activar
# notificaciones en /admin simplemente no hace nada (el checkout sigue
# funcionando normal). Genera el par de llaves UNA sola vez con:
#   npx web-push generate-vapid-keys
# y pega los valores tal cual (no los cambies después de que alguien ya
# se haya suscrito, o dejarían de recibir avisos).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@tudominio.com

# CRM de WhatsApp (opcional): bandeja + embudo de ventas en /admin/crm,
# conectado a la API OFICIAL de Meta (WhatsApp Business Platform / Cloud
# API) — la misma que usan por debajo CRMs como Kommo, sin arriesgar el
# número. Ver README.md > "CRM de WhatsApp" para la guía paso a paso.

# 1. Cuenta de servicio de Firebase (para que el webhook de Meta pueda
#    guardar mensajes sin que haya una sesión de administradora de por
#    medio). Firebase Console > Configuración del proyecto > Cuentas de
#    servicio > Generar nueva clave privada (descarga un .json):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Pega el valor de "private_key" del .json TAL CUAL, entre comillas,
# con los "\n" literales incluidos.
FIREBASE_ADMIN_PRIVATE_KEY=

# 2. Credenciales de WhatsApp Business Platform (Meta for Developers >
#    tu app > WhatsApp > Configuración de la API):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cualquier palabra que tú inventes — se pone también en Meta al configurar
# el webhook, solo para confirmar que la petición de verificación es tuya.
WHATSAPP_VERIFY_TOKEN=
# "App Secret" de tu app de Meta (Configuración básica) — verifica que cada
# mensaje entrante realmente venga de Meta y no de alguien más.
WHATSAPP_APP_SECRET=

# Meta Pixel (opcional pero MUY recomendado si vas a correr campañas de
# Meta Ads): mide quién ve un producto, agrega al carrito, inicia el pago
# y compra de verdad — sin esto, Meta Ads no puede optimizar la campaña
# hacia ventas reales. Ver README.md > "Meta Pixel" para la guía paso a paso.
NEXT_PUBLIC_META_PIXEL_ID=
# Opcional pero recomendado: hace que el evento de Compra llegue también
# desde el servidor (además del navegador), para que no se pierda en
# Safari/iPhone, que bloquean el pixel de JavaScript muy seguido.
META_CONVERSIONS_API_TOKEN=
# Opcional, solo mientras pruebas: el código de "Test Events" que te da
# Meta Events Manager, para ver los eventos llegar en vivo antes de lanzar
# la campaña de verdad. Bórralo cuando termines de probar.
META_TEST_EVENT_CODE=
