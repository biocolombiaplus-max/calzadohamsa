rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Productos: lectura pública, escritura solo administradores.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: cualquiera puede crear un pedido (checkout público),
    // pero solo el administrador puede leerlos, editarlos o borrarlos.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['items', 'subtotal', 'total', 'customer', 'paymentMethod', 'status'])
        && request.resource.data.status == 'pendiente';
      allow read, update, delete: if isAdmin();
    }

    // Lista de administradores: solo un admin ya autenticado puede leer/gestionar esta colección.
    // El primer admin debe crearse manualmente desde la consola de Firebase (ver README).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Configuración del sitio (textos, colores, WhatsApp, etc.): lectura
    // pública, escritura solo administradores.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Suscripciones de notificación push del celular de la administradora:
    // el checkout (público, sin sesión) necesita LEERLAS para poder avisarle
    // de un pedido nuevo, pero solo un admin ya logueado puede crear/borrar
    // la suscripción de su propio dispositivo.
    match /pushSubscriptions/{subId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // CRM de WhatsApp: datos privados de conversaciones con clientas, solo
    // la administradora puede verlos o tocarlos desde el panel. El webhook
    // de Meta (que recibe los mensajes entrantes sin ninguna sesión de por
    // medio) escribe usando el SDK de administrador de Firebase, que se
    // salta estas reglas — así que esto solo protege el acceso desde el
    // navegador.
    match /crmContacts/{contactId} {
      allow read, write: if isAdmin();
    }
    match /crmMessages/{messageId} {
      allow read, write: if isAdmin();
    }
    match /crmConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // Visitantes de la tienda (panel "Visitantes" en /admin, estilo
    // Shopify): la tienda guarda la actividad de cada visitante sin que
    // tenga que iniciar sesión (de dónde llega, qué ve, su carrito), y solo
    // la administradora puede ver la lista completa — así nadie externo ve
    // cuánto tráfico o qué clientas tiene la tienda. Leer UN registro por su
    // id (secreto, nadie puede adivinarlo ni listarlos) es lo que permite
    // recuperar el carrito desde el link que se le envía por WhatsApp.
    match /visitors/{vid} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || (
        vid.matches('^[a-f0-9]{24}$')
        && request.resource.data.keys().hasOnly(['firstSeen', 'visits', 'lastPath', 'landing', 'source', 'campaign', 'device',
             'products', 'cart', 'cartValue', 'stage', 'stageAt', 'name', 'phone', 'orderNumber', 'city', 'region',
             'lastSeen', 'pageviews', 'recoveryAt', 'recoveryCount'])
        && request.resource.data.get('cart', []).size() <= 15
        && request.resource.data.get('products', []).size() <= 6
        && request.resource.data.get('stage', 'visita') in ['visita', 'producto', 'carrito', 'checkout', 'compra']
      );
    }

    // Ventas reales recientes (solo primer nombre + ciudad + qué compró)
    // para el aviso "María compró hace 7 min" en la ficha de producto —
    // lectura pública (es justamente lo que se muestra en la tienda), pero
    // solo se puede crear un registro con esos 4 campos exactos, sin poder
    // inyectar nada más ni modificar uno ya creado.
    match /recentSales/{saleId} {
      allow get, list: if true;
      allow create: if isAdmin() || request.resource.data.keys().hasOnly(['firstName', 'city', 'productTitle', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Reseñas de clientas + bono de fidelización: la administradora crea el
    // "pedido de reseña" para una clienta que ya compró (con su propio
    // cupón del 10%), y la clienta entra sin iniciar sesión por un link
    // privado (el ID del pedido, que nadie puede adivinar ni listar) para
    // dejar su reseña y activar el bono. Solo puede cambiar los campos de
    // su propia reseña — nunca el cupón, el teléfono o el nombre.
    match /reviewRequests/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['rating', 'reviewText', 'reviewPhotos', 'reviewSubmittedAt', 'couponExpiresAt']);
    }

    // Cupón del bono de reseña: copia pública mínima (sin nombre ni
    // teléfono) para que el checkout —sin sesión de por medio— pueda
    // validarlo, aplicarlo desde el link y marcarlo como usado al terminar
    // la compra, sin poder tocar el porcentaje ni la fecha de vencimiento.
    match /rewardCoupons/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['usedAt', 'usedOrderId']);
    }
  }
}
